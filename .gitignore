# =========================================================
# Public repository whitelist
# Ignore everything by default, then only allow public mod files.
# =========================================================

*

# ---------------------------------------------------------
# Root public files
# ---------------------------------------------------------
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/LICENSE-CODE.txt
!/ASSETS_LICENSE.md

# ---------------------------------------------------------
# Gradle / Forge project files
# ---------------------------------------------------------
!/build.gradle
!/settings.gradle
!/gradle.properties
!/gradlew
!/gradlew.bat

# ---------------------------------------------------------
# Gradle wrapper
# ---------------------------------------------------------
!/gradle/
!/gradle/wrapper/
!/gradle/wrapper/**

# ---------------------------------------------------------
# Source code and resources
# ---------------------------------------------------------
!/src/
!/src/main/
!/src/main/**

# Datagen output, keep only if your mod needs it
!/src/generated/
!/src/generated/**

# ---------------------------------------------------------
# GitHub Actions, optional
# ---------------------------------------------------------
!/.github/
!/.github/workflows/
!/.github/workflows/**

# =========================================================
# Explicit private / junk blocks
# These are redundant because of the whitelist above,
# but kept here as safety warnings.
# =========================================================

build/
.gradle/
run/
logs/
crash-reports/
out/
bin/
/test_environment/
/.forge_src_check/

.idea/
.vscode/
/.claude/
/.kilo/
*.iml

/forge-1.19.2-43.5.2-mdk/
other_compact_mods/
characters_records/
items_records/
knowledge/
port_backups/
/com/
/net/
/docs/
/scripts/
/崩溃日志/
/问题图片/
旧版本/
备份/
设计稿/
开发日志/
档案/
临时素材/
Codex任务记录/

教导日志.md
/AGENTS.md
task_plan.md
progress.md
findings.md
存在的问题.txt
/需要测试的点.txt
/FIX_SUMMARY.txt
/changelog.txt
/CREDITS.txt
/LICENSE.txt
/README.txt

.env
*.env
secrets.*
*.key
*.pem
*token*
*password*
*secret*

# Source-tree hardening. `src/main/**` is public, so block accidental
# generated files, editor backups, OS metadata, and archives inside it.
/src/**/.DS_Store
/src/**/Thumbs.db
/src/**/desktop.ini
/src/**/__pycache__/
/src/**/.cache/
/src/**/*.class
/src/**/*.jar
/src/**/*.zip
/src/**/*.7z
/src/**/*.rar
/src/**/*.log
/src/**/*.tmp
/src/**/*.temp
/src/**/*.bak
/src/**/*.old
/src/**/*.orig
/src/**/*.rej
/src/**/*.swp
/src/**/*.swo
/src/**/*~
